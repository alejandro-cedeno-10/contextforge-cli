{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contextforge.dev/schemas/implement-plan.schema.json",
  "title": "ImplementPlan",
  "description": "Plan ejecutable por agente con guardrails de alcance. Producto de `forge implement`.",
  "type": "object",
  "required": ["schemaVersion", "taskId", "status", "guardrails", "tasks"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "taskId": {
      "type": "string",
      "description": "ID estable que correlaciona con context-pack.json y spec.sdd.md."
    },
    "title": { "type": "string" },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": ["plan_only", "approved_for_edit", "rejected", "completed"],
      "description": "plan_only por defecto. Cambiar a approved_for_edit requiere accion humana explicita."
    },
    "contextPackRef": {
      "type": "object",
      "required": ["path", "packHash"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string" },
        "packHash": { "type": "string" }
      }
    },
    "specRef": {
      "type": "object",
      "required": ["path"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string" },
        "format": {
          "type": "string",
          "enum": ["sdd-md", "openspec", "speckit"]
        }
      }
    },
    "guardrails": {
      "type": "object",
      "required": ["allowedFiles", "forbiddenPaths", "maxLocDelta"],
      "additionalProperties": false,
      "description": "Restricciones que el agente debe respetar. Validables post-edit.",
      "properties": {
        "allowedFiles": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Globs de archivos donde el agente puede editar. Cualquier edicion fuera = violacion."
        },
        "forbiddenPaths": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Globs prohibidos siempre (ej. **/secrets/**, **/.env*, migrations/old/**)."
        },
        "maxLocDelta": {
          "type": "integer",
          "minimum": 1,
          "description": "Maximo de lineas (added + removed) permitido. Excede = requiere re-aprobacion."
        },
        "maxFilesChanged": {
          "type": "integer",
          "minimum": 1,
          "description": "Maximo numero de archivos modificados."
        },
        "requiredTests": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Tests (paths o nombres) que DEBEN ejecutarse y pasar antes de marcar completed."
        },
        "noNewDependencies": {
          "type": "boolean",
          "default": true,
          "description": "Si true, agregar deps a package.json/requirements.txt requiere re-aprobacion."
        },
        "preserveAPI": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Symbol IDs cuya signatura no debe cambiar (breaking change protection)."
        }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/taskItem" }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "description": "Resultado de `forge implement --check`. Vacio hasta ejecutar.",
      "properties": {
        "ranAt": { "type": "string", "format": "date-time" },
        "violations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["rule", "detail"],
            "additionalProperties": false,
            "properties": {
              "rule": { "type": "string" },
              "detail": { "type": "string" },
              "file": { "type": "string" }
            }
          }
        },
        "passed": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "taskItem": {
      "type": "object",
      "required": ["id", "description", "files"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^T[0-9]+(\\.[0-9]+)*$",
          "description": "ID jerarquico estilo OpenSpec: T1, T1.1, T1.2."
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "files": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Archivos que esta task tocara. Subset de guardrails.allowedFiles."
        },
        "acceptanceCriteria": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Verificables por test o inspeccion."
        },
        "tests": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Tests especificos a anadir o modificar."
        },
        "blockedBy": {
          "type": "array",
          "items": { "type": "string", "pattern": "^T[0-9]+(\\.[0-9]+)*$" }
        },
        "estimatedTokens": {
          "type": "integer",
          "minimum": 0,
          "description": "Tokens estimados que el agente consumira ejecutando esta task."
        }
      }
    }
  }
}
